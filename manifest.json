{
  "manifest_version": 3,
  "name": "GoStandUp",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "assets/stand-up.png"
  },
  "permissions": ["alarms", "storage", "runtime"]
}